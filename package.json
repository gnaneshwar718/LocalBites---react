{
    "name": "localbites-fullstack",
    "version": "1.0.0",
    "description": "LocalBites Full Stack Application",
    "main": "server.js",
    "type": "module",
    "workspaces": [
        "frontend"
    ],
    "scripts": {
        "start": "node server.js",
        "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
        "server:dev": "nodemon server.js",
        "client:dev": "npm run dev --workspace=frontend",
        "build": "npm run build --workspace=frontend",
        "db:view": "node view-db.js"
    },
    "dependencies": {
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "concurrently": "^8.2.2",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "nodemon": "^3.1.0"
    },
    "lint-staged": {
        "*.{js,jsx,json,css,md}": [
            "echo 'Linting...'"
        ]
    }
}